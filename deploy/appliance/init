#!/bin/busybox sh
set -eu
export PATH=/bin:/usr/bin:/usr/local/bin
ulimit -c 0
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid devtmpfs /dev
mkdir -p /dev/pts /sys/kernel/security
mount -t devpts -o nosuid,noexec devpts /dev/pts
mount -t securityfs -o nosuid,nodev,noexec securityfs /sys/kernel/security
mount -t tmpfs -o nosuid,nodev,noexec,size=16m tmpfs /run
mount -t tmpfs -o nosuid,nodev,noexec,size=16m tmpfs /tmp
for driver in hv_vmbus hv_netvsc tpm_crb tpm_tis; do modprobe "$driver" 2>/dev/null || true; done
for entry in /sys/class/net/*; do
    name=${entry##*/}
    if [ "$name" != lo ]; then ip link set "$name" up; udhcpc -f -q -n -t 10 -i "$name" -s /etc/axiom-gateway/dhcp; break; fi
done
test -c /dev/tpm0
chown 10001:10001 /dev/tpm0
chmod 600 /dev/tpm0
if [ -c /dev/tpmrm0 ]; then chown 10001:10001 /dev/tpmrm0; chmod 600 /dev/tpmrm0; fi
# Public firmware boot evidence is readable by the sole application user.
chmod a+r /sys/kernel/security/tpm0/binary_bios_measurements
echo 0 > /proc/sys/kernel/sysrq
echo 1 > /proc/sys/kernel/dmesg_restrict
echo 2 > /proc/sys/kernel/kptr_restrict
if [ -e /proc/sys/kernel/yama/ptrace_scope ]; then echo 3 > /proc/sys/kernel/yama/ptrace_scope; fi
mount -o remount,ro /
# No login, SSH, serial shell, container daemon, agent, writable disk or swap.
# Failure reboots into the same measured image; there is no rescue shell.
setpriv --reuid=10001 --regid=10001 --clear-groups --no-new-privs --bounding-set=-all /usr/local/bin/axiom-web-gateway /etc/axiom-gateway/config.json || true
reboot -f
